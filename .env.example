# Database configuration
DB_USER=user
DB_PASSWORD=password
DB_NAME=name

# API auth
SECRET_KEY=change-me-with-openssl-rand-base64-48-before-any-deploy
DEMO_MODE=false

# API URL for frontend (dev: http://localhost:8081, prod: /api)
REACT_APP_API_URL=http://localhost:8081

# Backup storage (S3 compatible, e.g. Cloudflare R2)
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_BUCKET=mokart-backups
S3_ACCESS_KEY_ID=key-id
S3_SECRET_ACCESS_KEY=secret

# PGAdmin configuration
PGADMIN_EMAIL=email
PGADMIN_PASSWORD=password

# NocoDB configuration
NC_ADMIN_EMAIL=admin@mokart.fr
NC_ADMIN_PASSWORD=Change-me-1
NC_AUTH_JWT_SECRET=change-me-with-openssl-rand-base64-48
